{
  "name": "limbus-backend",
  "version": "1.0.0",
  "description": "API Limbus — Node.js + Express + SQLite",
  "main": "server.js",
  "scripts": {
    "start":      "node server.js",
    "test":       "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "lint":       "eslint . --ext .js",
    "lint:fix":   "eslint . --ext .js --fix",
    "format":     "prettier --write \"**/*.js\""
  },
  "keywords": [],
  "author": "Guilherme Bardalho",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "eslint":    "^8.57.0",
    "jest":      "^29.7.0",
    "prettier":  "^3.3.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
